# Copy to .env, which is ignored. Never commit real values.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_STRUCTURED_OUTPUTS=true
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX=project-docs
AZURE_DI_ENDPOINT=https://YOUR-DI.cognitiveservices.azure.com/
AZURE_DI_API_KEY=
# Existing Faundry_key and DI_key names are accepted as fallback aliases.
